APP_NAME=服务管理系统
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///repair_management.db
UPLOAD_DIR=uploads
REPORT_DIR=output/pdf
EMAIL_SNAPSHOT_DIR=output/email_snapshots
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
ALLOW_LAN=false
SYNC_ROLE=standalone
SYNC_NODE_ID=
SYNC_NODE_NAME=
SYNC_HOST_URL=
SYNC_SHARED_SECRET=
SYNC_INTERVAL_SECONDS=300
BACKUP_DIR=backups/system
# 本机资料库目录；“一键导入资料库”只读取该目录内名称含位号图/位置图/丝印图/点位图的 PDF。
POINT_MAP_REFERENCE_ROOT=F:/大疆官方资料
POINT_MAP_IMPORT_BATCH_LIMIT=500
MAX_UPLOAD_BYTES=52428800
ALLOWED_ATTACHMENT_EXTENSIONS=.jpg,.jpeg,.png,.webp,.mp4,.mov,.pdf,.txt,.dat,.ulg,.bin,.csv,.zip
# 可选。留空时自动发现 Windows / Linux / macOS 可用中文字体。
PDF_FONT_PATH=
PDF_LOGO_PATH=
PDF_BRAND_NAME=服务品牌
PDF_QUOTE_TITLE=服务平台服务报价单
PDF_FOOTER_TEXT=感谢您选择 服务品牌
PDF_PAYMENT_URL=
# 企业微信密钥仅允许配置在本机 .env；WECOM_MODE=real 前先完成测试应用验证。
WECOM_MODE=mock
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=
# 兼容旧配置；新部署请使用 WECOM_APP_SECRET。
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
WECOM_CALLBACK_HOST=127.0.0.1
WECOM_CALLBACK_PORT=8011
WECOM_TIMEOUT_SECONDS=15
SF_PARTNER_ID=
SF_CHECKWORD=
# 邮件默认使用 mock，完整构建邮件和 PDF 但不会向外部投递。
# 确认 SMTP 参数正确后，将 EMAIL_MODE 改为 smtp 并重启服务。
EMAIL_MODE=mock
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# 可选：DJI 官方 FlightRecordParsingLib v13 的本机包装程序。
# 包装程序接收日志绝对路径作为唯一参数，并把 UTF-8 JSON 写到标准输出；App Key 由包装程序安全管理。
DJI_FLIGHT_RECORD_PARSER_PATH=
DJI_FLIGHT_RECORD_PARSER_TIMEOUT_SECONDS=120

# 登录会话；通过 HTTPS 访问时必须改为 true
SESSION_HOURS=12
SESSION_COOKIE_SECURE=false
CLIENT_SESSION_COOKIE_NAME=service_client_session
CLIENT_SESSION_DAYS=30
CLIENT_SESSION_COOKIE_SECURE=false
CLIENT_LOGIN_MAX_FAILURES=5
CLIENT_LOGIN_LOCK_MINUTES=15
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCK_MINUTES=15
CLIENT_MAX_IMAGE_BYTES=10485760
CLIENT_MAX_VIDEO_BYTES=104857600
CLIENT_MAX_UPLOADS_PER_RESOURCE=12
PASSWORD_HASH_ITERATIONS=310000
TRUSTED_HOSTS=localhost,127.0.0.1
# 仅在隔离调试环境临时启用；管理端正常使用不需要 API 文档。
ENABLE_API_DOCS=false
ENFORCE_DATABASE_REVISION=true
# 不建议启用。局域网地址会由程序自动加入可信主机列表。
ALLOW_UNSAFE_TRUSTED_HOST_WILDCARD=false
